# Craft Stash settings. Copy to .env (or paste into Dockhand / Portainer stack variables) and change what you need.
# Every line is optional: an empty value means the default shown in its comment. A setting ending in _FILE reads
# the value from that file instead (Docker secrets), e.g. DB_PASSWORD_FILE=/run/secrets/db_password.

# ---- General ----
# Host port for the web UI (container port 8000). Not needed when a proxy on the same Docker network is the way in.
PORT=8080
# Who owns the files in the mapped folders. Unraid: 99 / 100.
PUID=10001
PGID=10001
# Time zone for the activity log, e.g. Australia/Brisbane
TZ=UTC
# Image to run: craft-stash:latest builds from this repo; ghcr.io/relicgaming/craftstash:latest pulls the CI build
# (every build is also tagged :sha-<commit>, to pin or roll back)
IMAGE=craft-stash:latest

# ---- Security ----
# Open sign-up when the app first starts (the Admin page can change it). 0 also stops the first visitor from
# signing up as admin; create one with manage.py create-user --admin instead.
ALLOW_SIGNUP=1
# auto = secure cookies whenever the request came in over HTTPS; 1 = always; 0 = never
COOKIE_SECURE=auto
# Session signing key. Empty = generated once into /data/secret_key. Or SECRET_KEY_FILE=/run/secrets/...
SECRET_KEY=
# Largest single upload, in MB (raise the proxy's limit to match)
MAX_UPLOAD_MB=25
# Uploaded files per user, in MB. 0 = unlimited.
USER_QUOTA_MB=500

# ---- Storage ----
# Everything lives under /data unless a folder below is mapped to its own volume or host folder. A folder that is
# set must exist (be mapped): the app refuses to start rather than write into the container, where files would fill
# Docker's own disk (the vdisk on Unraid) and vanish when the container is recreated.
# Pattern and guide files (default /data/uploads), e.g. /files
UPLOADS_DIR=
# Item and step photos (default: a photos folder inside UPLOADS_DIR), e.g. /photos
PHOTOS_DIR=
# Daily database snapshots and safety copies (default /data/backups), e.g. /backups
BACKUP_DIR=
# Uploads while they arrive, backup zips, restore staging (default /data/tmp). Must be a folder of its own.
TMP_DIR=
# Self-test reports (default /data/selftest)
SELFTEST_DIR=
# Ownership fixes at start: auto = only where wrong, always = every file every start, never = leave it (NAS shares)
CHOWN=auto

# ---- Reverse proxy ----
# Set to 1 behind Nginx Proxy Manager (or another proxy). Only when it is the only way in, unless TRUSTED_PROXIES is set.
TRUST_PROXY=0
# Only believe forwarded headers from these addresses or ranges (the proxy), e.g. 172.16.0.0/12. Implies TRUST_PROXY=1.
TRUSTED_PROXIES=
# Serve the app under a path, e.g. /craft for https://example.com/craft/
URL_PREFIX=

# ---- Database ----
# Empty = SQLite in /data (the default, nothing to set up). For PostgreSQL 13+ or MariaDB 10.6+ / MySQL 8.0.13+, a URL:
#   DATABASE_URL=postgresql://craftstash:secret@postgres:5432/craftstash
#   DATABASE_URL=mysql://craftstash:secret@mariadb:3306/craftstash
# or DATABASE_URL_FILE, or DB_TYPE (postgres, mariadb or mysql) and the parts below.
DATABASE_URL=
DB_TYPE=
# Default: postgres or mariadb (the bundled containers' names)
DB_HOST=
# Default: 5432 or 3306
DB_PORT=
# Default: craftstash
DB_NAME=
# Default: craftstash
DB_USER=
# Or DB_PASSWORD_FILE=/run/secrets/db_password
DB_PASSWORD=
# disable | prefer | require | verify-full
DB_SSLMODE=
# Seconds to keep retrying the database at startup (it may still be starting)
DB_CONNECT_TIMEOUT=60

# ---- Backups ----
# Daily database snapshots to keep in BACKUP_DIR, 0 = off
BACKUP_KEEP=7

# ---- Bundled extras (docker compose profiles) ----
# npm = Nginx Proxy Manager, postgres / mariadb = a database container (also set DB_TYPE and DB_PASSWORD). e.g. npm,postgres
COMPOSE_PROFILES=
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
# Named volumes by default; set host folders to keep them elsewhere (e.g. /mnt/user/appdata/craft-stash-npm/data)
NPM_DATA_DIR=npm-data
NPM_LETSENCRYPT_DIR=npm-letsencrypt
POSTGRES_DATA_DIR=postgres-data
MARIADB_DATA_DIR=mariadb-data
# The images the bundled services run
NPM_IMAGE=jc21/nginx-proxy-manager:2
POSTGRES_IMAGE=postgres:17-alpine
MARIADB_IMAGE=mariadb:11
# Your own proxy's Docker network, when joining it (see docker-compose.yml)
PROXY_NETWORK=proxy
