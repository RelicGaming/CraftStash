PORT=8080
PUID=10001
PGID=10001
TZ=UTC
# Set to 1 only when Nginx Proxy Manager (or another proxy) is the only way in. With 0 the port can be exposed safely.
TRUST_PROXY=0
COOKIE_SECURE=auto
ALLOW_SIGNUP=1
MAX_UPLOAD_MB=25
USER_QUOTA_MB=500
BACKUP_KEEP=7
SECRET_KEY=

# ---- Storage ----
# Everything lives under /data unless a folder below is mapped to its own volume or host folder. Leave a line empty to
# keep the default. A folder that is set must exist (be mapped): the app refuses to start rather than write into the
# container, where files would fill Docker's own disk (the vdisk on Unraid) and vanish when the container is recreated.
# Pattern and guide files (default /data/uploads), e.g. /files
UPLOADS_DIR=
# Item and step photos (default: a photos folder inside UPLOADS_DIR), e.g. /photos
PHOTOS_DIR=
# Daily database snapshots and safety copies (default /data/backups), e.g. /backups
BACKUP_DIR=
# Uploads while they arrive, backup zips, restore staging (default /data/tmp). Must be a folder of its own.
TMP_DIR=
# auto = fix ownership only where it's wrong, always = every file every start, never = leave it (NAS shares)
CHOWN=auto
